+def _phase160_profile_render_kpts(views, gaussians, pipeline, background,
+                                  kpts, kpts_rotation, weights_xyz, weights_r,
+                                  life_opacity):
+    """Profile frozen dense mapping and rasterization without saving images."""
+    output_path = os.environ.get("PHASE160_PROFILE_JSON")
+    if not output_path:
+        return
+    if gaussians.compact_nearest is not None:
+        raise RuntimeError("Phase160 renderer factorial requires matched dense bindings")
+
+    warmup = int(os.environ.get("PHASE160_WARMUP", "5"))
+    repeats = int(os.environ.get("PHASE160_REPEATS", "3"))
+    gaussian_xyz = gaussians.get_xyz
+    gaussian_kpts = gaussians.super_gaussians
+
+    def run_frame(frame_index, record=False):
+        mapping_start = torch.cuda.Event(enable_timing=True) if record else None
+        mapping_stop = torch.cuda.Event(enable_timing=True) if record else None
+        raster_stop = torch.cuda.Event(enable_timing=True) if record else None
+        if record:
+            mapping_start.record()
+        xyz_final = gaussian_xyz + (
+            weights_xyz @ (kpts[frame_index] - gaussian_kpts)
+        )
+        blended_rotation = weights_r @ kpts_rotation[frame_index]
+        delta_r = gaussians.get_rotation_(
+            gaussians.rotation_activation(blended_rotation)
+        )
+        if record:
+            mapping_stop.record()
+        render_motion(
+            views[frame_index], gaussians, pipeline, background,
+            xyz_t=xyz_final, r_t=delta_r, opacity=life_opacity,
+        )
+        if record:
+            raster_stop.record()
+            return mapping_start, mapping_stop, raster_stop
+
+    for index in range(warmup):
+        run_frame(index % len(kpts), record=False)
+    torch.cuda.synchronize()
+
+    events = []
+    torch.cuda.synchronize()
+    wall_start = time.time()
+    for _ in range(repeats):
+        for index in range(len(kpts)):
+            events.append(run_frame(index, record=True))
+    torch.cuda.synchronize()
+    wall_seconds = time.time() - wall_start
+
+    mapping_ms = [start.elapsed_time(stop) for start, stop, _ in events]
+    raster_ms = [stop.elapsed_time(end) for _, stop, end in events]
+    complete_ms = [start.elapsed_time(end) for start, _, end in events]
+    count = len(events)
+    payload = {
+        "warmup_frames": warmup,
+        "profile_frames": count,
+        "mapping_gpu_ms_mean": float(np.mean(mapping_ms)),
+        "raster_gpu_ms_mean": float(np.mean(raster_ms)),
+        "complete_gpu_ms_mean": float(np.mean(complete_ms)),
+        "batched_wall_seconds": wall_seconds,
+        "batched_end_to_end_fps": count / wall_seconds,
+    }
+    os.makedirs(os.path.dirname(os.path.abspath(output_path)), exist_ok=True)
+    with open(output_path, "w") as handle:
+        json.dump(payload, handle, indent=2)
+    print("PHASE160_PROFILE " + json.dumps(payload, sort_keys=True))
+
