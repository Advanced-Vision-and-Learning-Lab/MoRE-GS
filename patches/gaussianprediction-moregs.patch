+def _bounded_kmeans(features, clusters, tol=1e-4, max_iterations=300):
+    """Match kmeans_pytorch's Euclidean update with a finite safety cap.
+
+    The upstream implementation uses ``while True`` and can oscillate forever
+    on large GaussianPrediction point sets.  Keep its initialization, distance,
+    tolerance and Lloyd update, but make termination deterministic.
+    """
+    values = features.float().to(features.device)
+    centers = initialize(values, clusters)
+    assignments = None
+    center_shift_sq = float("inf")
+    for iteration in range(1, max_iterations + 1):
+        distances = pairwise_distance(values, centers)
+        assignments = torch.argmin(distances, dim=1)
+        previous = centers.clone()
+        for index in range(clusters):
+            selected = torch.nonzero(assignments == index).squeeze().to(values.device)
+            if selected.numel() > 0:
+                centers[index] = torch.index_select(values, 0, selected).mean(dim=0)
+        center_shift_sq = torch.sum(
+            torch.sqrt(torch.sum((centers - previous) ** 2, dim=1))
+        ).pow(2).item()
+        if center_shift_sq < tol:
+            break
+    print(
+        "bounded k-means: iterations={} center_shift={:.6f} tol={:.6f}{}".format(
+            iteration,
+            center_shift_sq,
+            tol,
+            " (cap reached)" if iteration == max_iterations and center_shift_sq >= tol else "",
+        )
+    )
+    return assignments.cpu(), centers.cpu()
+
