+def _ms_ssim_at_native_resolution(render, gt):
+    """Evaluate MS-SSIM without changing the native image resolution.
+
+    The upstream default 11-pixel window requires both spatial dimensions to
+    exceed 160 pixels.  For smaller images, use the largest supported odd
+    window (7 for the 128x128 ManiSkill evaluation).  The paper-facing SSIM,
+    PSNR, and LPIPS computations are unchanged.
+    """
+    min_side = min(render.shape[-2:])
+    win_size = 11 if min_side > 160 else 7
+    return ms_ssim(
+        render, gt, data_range=1, size_average=True, win_size=win_size
+    )
 
